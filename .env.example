# Copy this file to .env and fill in real values. Never commit .env.

# TheirStack API key: https://app.theirstack.com/settings/api-key
THEIRSTACK_API_KEY=your-theirstack-api-key

# SEC asks automated tools to identify themselves with a name and a contact email
SEC_USER_AGENT=Your Name your-email@example.com

# HubSpot service key (Development > Keys > Service keys), used in step 4
HUBSPOT_SERVICE_KEY=your-hubspot-service-key

# Apollo API key, created in Apollo's settings. Used only by apollo_sequence.py, which can
# create an inactive draft sequence and nothing else. Leave it out until you need it.
APOLLO_API_KEY=your-apollo-api-key

# Hunter API key (free plan: 50 credits a month). Used only by find_contacts.py, which reads
# and never sends. Leave it out until you need it.
HUNTER_API_KEY=your-hunter-api-key

# Anthropic API key (Claude Console > API keys). Used only by judge_fit.py, a review-time step
# that asks a model for a second opinion on each company. The weekly job never runs it and
# never sees this key. Leave it out until you need it.
ANTHROPIC_API_KEY=your-anthropic-api-key
